<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --cream: #F7F3EE;
      --ink: #1A1612;
      --gold: #D4A853;
      --card-bg: #FFFFFF;
    }
    body {
      background: var(--cream);
      font-family: 'DM Sans', sans-serif;
      color: var(--ink);
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 40px 24px;
    }
    .card {
      background: var(--card-bg);
      border-radius: 20px;
      padding: 44px 36px;
      position: relative;
      overflow: hidden;
      max-width: 340px;
      width: 100%;
      box-shadow: 0 2px 0 rgba(0,0,0,0.06), 0 8px 32px rgba(0,0,0,0.05);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      opacity: 0;
      transform: translateY(24px);
      animation: fadeUp 0.7s ease forwards 0.2s;
    }
    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 4px 0 rgba(0,0,0,0.08), 0 16px 48px rgba(0,0,0,0.1);
    }
    .card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 4px;
      background: var(--gold);
      border-radius: 20px 20px 0 0;
    }
    .card-circle {
      position: absolute;
      bottom: -40px; right: -40px;
      width: 140px; height: 140px;
      border-radius: 50%;
      background: var(--gold);
      opacity: 0.07;
    }
    .card-icon { font-size: 32px; margin-bottom: 20px; display: block; }
    .card-label {
      font-size: 11px; font-weight: 500;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: #9B918A; margin-bottom: 12px;
    }
    .card-number {
      font-family: 'Playfair Display', serif;
      font-size: 72px; font-weight: 900;
      line-height: 1; color: var(--gold); margin-bottom: 6px;
    }
    .card-number .suffix { font-size: 32px; font-weight: 700; }
    .card-title { font-size: 17px; font-weight: 500; color: var(--ink); margin-bottom: 10px; line-height: 1.3; }
    .card-desc { font-size: 14px; font-weight: 300; color: #7A706A; line-height: 1.65; }
    .bar-wrap { margin-top: 20px; }
    .bar-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
    .bar-row-label { font-size: 11px; font-weight: 500; color: #9B918A; width: 80px; flex-shrink: 0; }
    .bar-track { flex: 1; height: 8px; background: #F0EBE6; border-radius: 99px; overflow: hidden; }
    .bar-fill { height: 100%; border-radius: 99px; width: 0%; transition: width 1.6s cubic-bezier(0.4, 0, 0.2, 1); }
    .bar-fill-whitley { background: var(--gold); }
    .bar-fill-industry { background: #D4C8C0; }
    .bar-val { font-size: 12px; font-weight: 500; color: var(--ink); width: 36px; text-align: right; flex-shrink: 0; }
    @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }
  </style>
</head>
<body>
  <div class="card">
    <div class="card-circle"></div>
    <span class="card-icon">📬</span>
    <p class="card-label">Email Open Rate</p>
    <div class="card-number"><span id="count">0</span><span class="suffix">%</span></div>
    <p class="card-title">Open rate for veteran nonprofit email campaign</p>
    <p class="card-desc">More than double the industry average, achieved through audience trust, relevant content, and one clear call to action.</p>
    <div class="bar-wrap">
      <div class="bar-row">
        <span class="bar-row-label">Whitley</span>
        <div class="bar-track"><div class="bar-fill bar-fill-whitley" id="barWhitley"></div></div>
        <span class="bar-val">47%</span>
      </div>
      <div class="bar-row">
        <span class="bar-row-label">Industry avg</span>
        <div class="bar-track"><div class="bar-fill bar-fill-industry" id="barIndustry"></div></div>
        <span class="bar-val">22%</span>
      </div>
    </div>
  </div>
  <script>
    function animateCount(target, duration) {
      let start = 0;
      const el = document.getElementById('count');
      const step = (ts) => {
        if (!start) start = ts;
        const progress = Math.min((ts - start) / duration, 1);
        const ease = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.floor(ease * target);
        if (progress < 1) requestAnimationFrame(step);
        else el.textContent = target;
      };
      requestAnimationFrame(step);
    }
    function trigger() {
      animateCount(47, 1600);
      setTimeout(() => {
        document.getElementById('barWhitley').style.width = '94%';
        document.getElementById('barIndustry').style.width = '44%';
      }, 200);
    }
    const observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) { trigger(); observer.disconnect(); }
    }, { threshold: 0.25 });
    observer.observe(document.querySelector('.card'));
    window.addEventListener('load', () => {
      const rect = document.querySelector('.card').getBoundingClientRect();
      if (rect.top < window.innerHeight * 0.9) { trigger(); observer.disconnect(); }
    });
  </script>
</body>
</html>
